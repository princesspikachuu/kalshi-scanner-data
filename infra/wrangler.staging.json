{
  "name": "pocket-analytics-staging",
  "main": "../apps/gateway/index.mjs",
  "compatibility_date": "2026-10-26",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../apps/web",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/live-paper"]
  },
  "keep_vars": true,
  "observability": {
    "logs": { "enabled": true, "invocation_logs": true, "head_sampling_rate": 1 },
    "traces": { "enabled": false }
  },
  "vars": {
    "APP_ORIGIN": "https://pocket-analytics-staging.ezrealrose831.workers.dev",
    "API_ORIGIN": "https://pocket-api-staging.onrender.com"
  }
}
