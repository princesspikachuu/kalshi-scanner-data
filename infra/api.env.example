# Example names only. Store actual values in a local untracked environment or Render.
APP_ORIGIN=https://your-staging-app.example
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
OWNER_GOOGLE_EMAIL=your-owner-google-account@example.com
# For non-Gmail/non-Workspace accounts, provision by verified stable subject instead.
# OWNER_GOOGLE_SUB=your-verified-google-subject
DATABASE_URL=postgresql://user:password@private-db-host:5432/database
API_PROXY_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
