{
  "name": "kalshi-pocket-analytics",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-10-25",
  "assets": {
    "directory": "./docs",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "ratelimits": [
    {
      "name": "COLLECTION_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 1,
        "period": 60
      }
    }
  ]
}
